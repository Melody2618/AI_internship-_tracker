rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Signed in with a verified Google account whose email has a
    // document in the "allowlist" collection (document ID = lowercase email).
    function isAllowed() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/allowlist/$(request.auth.token.email.lower()));
    }

    // Job postings: readable only by allowlisted users.
    // Writes come from the GitHub Actions cron via the Admin SDK,
    // which bypasses these rules, so clients can never write.
    match /jobs/{jobId} {
      allow read: if isAllowed();
      allow write: if false;
    }

    // Each user may check only their own allowlist entry.
    // The list is managed in the Firebase console.
    match /allowlist/{email} {
      allow read: if request.auth != null
        && request.auth.token.email.lower() == email;
      allow write: if false;
    }
  }
}
